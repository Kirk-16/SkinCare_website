rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 3. Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function existing() {
      return resource.data;
    }

    // 1. Master Gate (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Validation Blueprints
    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email is string && data.email.size() <= 100
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100))
        && (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500))
        && (data.preferences == null || (data.preferences is string && data.preferences.size() <= 1000));
    }

    function isValidWishlistItem(data) {
      return data.productId is string && data.productId.size() <= 100
        && data.addedAt == request.time;
    }

    function isValidReview(data) {
      return data.productId is string && data.productId.size() <= 100
        && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() <= 2000
        && data.createdAt == request.time;
    }

    // Collection Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(incoming())
        && incoming().keys().hasAll(['uid', 'email']) && incoming().keys().size() <= 5;
      allow update: if isOwner(userId) && isEmailVerified() && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferences']);
      
      match /wishlist/{productId} {
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isEmailVerified() && isValidId(productId) && isValidWishlistItem(incoming())
          && incoming().keys().hasAll(['productId', 'addedAt']) && incoming().keys().size() == 2;
        allow delete: if isOwner(userId) && isEmailVerified();
      }
    }

    match /products/{productId}/reviews/{reviewId} {
      allow list: if true; // Publicly readable
      allow get: if true;
      allow create: if isEmailVerified() && isValidId(productId) && isValidId(reviewId) && isValidReview(incoming())
        && incoming().keys().hasAll(['productId', 'userId', 'userName', 'rating', 'comment', 'createdAt'])
        && incoming().keys().size() == 6;
      allow update: if isOwner(existing().userId) && isEmailVerified() && isValidReview(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['comment', 'rating']);
      allow delete: if isOwner(existing().userId) && isEmailVerified();
    }
  }
}
